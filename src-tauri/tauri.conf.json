{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Incognitus",
  "version": "0.5.0",
  "mainBinaryName": "incognitus",
  "identifier": "br.eco.consciencia.incognitus",
  "build": {
    "frontendDist": "../modulo"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Incognitus",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": true,
        "backgroundColor": "#c8703f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pdftotext",
      "binaries/pdftoppm",
      "binaries/tesseract"
    ],
    "resources": {
      "recursos/tessdata/": "tessdata/",
      "recursos/LICENCAS-terceiros/": "LICENCAS-terceiros/",
      "../plugin/recursos/fontes/LICENSE_DEJAVU": "LICENCAS-terceiros/DejaVu-LICENSE.txt"
    },
    "category": "Productivity",
    "shortDescription": "Anonimização de PDFs em lote, no computador",
    "longDescription": "Incognitus anonimiza autos em PDF com o motor de anonimização do Graphé, sem tirar nada do computador.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
